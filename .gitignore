**/.svn/
**/*.svn-base
**/*.i~
**/*.i#
**/*.py~
**/*.vi
**/*~

# Build outputs and runtime artifacts.
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.o
**/*.obj
**/*.a
**/*.so
**/*.dll
**/*.exe
**/*.log
**/*.tmp

# OS/editor noise.
/.codex-remote-attachments/
.DS_Store
Thumbs.db
desktop.ini
