# Only the active source snapshot is tracked under "PC TP IR".
/PC TP IR/*
!/PC TP IR/TP_Master_version/
!/PC TP IR/TP_Master_version/**

# Historical repositories kept for reference only.
/PC TP IR/yorick.git/
/PC TP IR/Yorick/

# Generated bundles can be rebuilt from tools/.
/dist/

